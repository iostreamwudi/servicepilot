# Alibaba Cloud Model Studio (Bailian) OpenAI-compatible gateway.
# Keep the real API key in the Sites runtime, never in this file.
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
LLM_MODEL=minimax-m3
LLM_API_KEY=replace-in-runtime
EMBEDDING_MODEL=qwen3.7-text-embedding
# Shadow retrieval only records telemetry; it never changes the production answer.
RETRIEVAL_SHADOW_ENABLED=false
# Phase 1 V2 optional semantic reranker. When disabled or unavailable, V2
# records rerankFallback=true and continues with RRF + bounded business boost.
RERANK_ENABLED=false
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANK_MODEL=qwen3-rerank
RERANK_TIMEOUT_MS=1500
# Phase 1 defaults are starting points and must be tuned with frozen retrieval evals.
RETRIEVAL_V2_BM25_TOP_K=30
RETRIEVAL_V2_DENSE_TOP_K=30
RETRIEVAL_V2_FUSION_TOP_K=25
RETRIEVAL_V2_RERANK_TOP_K=8
RETRIEVAL_V2_RRF_K=60
RETRIEVAL_V2_MAX_BUSINESS_BOOST=0.0005
